# Copy this file to .env and replace every required placeholder.

# Microsoft Fabric
FABRIC_WORKSPACE_ID=
FABRIC_WORKSPACE_NAME=Facilities Maintenance & Reliability
FABRIC_CAPACITY_ID=
FABRIC_CAPACITY_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Fabric/capacities/<capacity-name>
FABRIC_LAKEHOUSE_ID=
FABRIC_LAKEHOUSE_NAME=FacilitiesMaintenanceLakehouse
FABRIC_SQL_ENDPOINT_ID=
FABRIC_SQL_DATABASE_ID=
FABRIC_SQL_DATABASE_NAME=FacilitiesMaintenanceOperational
FABRIC_SQL_CONNECTION_STRING=
# Optional analogous-work-order RAG layer.
ENABLE_WORK_ORDER_RAG=false
FABRIC_SEMANTIC_MODEL_ID=
FABRIC_SEMANTIC_MODEL_NAME=Maintenance & Reliability Analytics
FABRIC_DATA_AGENT_NAME=Maintenance Operations Advisor
FABRIC_DATA_AGENT_ID=

# Azure OpenAI and Azure AI Search (required only when ENABLE_WORK_ORDER_RAG=true)
AZURE_SUBSCRIPTION_ID=
AZURE_OPENAI_RESOURCE=
AZURE_OPENAI_RESOURCE_GROUP=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_AI_SEARCH_RESOURCE_GROUP=
AZURE_AI_SEARCH_SERVICE=
AZURE_AI_SEARCH_LOCATION=westus2
AZURE_AI_SEARCH_INDEX=completed-work-orders

# SharePoint
MICROSOFT_TENANT_ID=
SHAREPOINT_TENANT_HOST=<tenant>.sharepoint.com
SHAREPOINT_SITE_TITLE=Operations & Maintenance Knowledge Center
SHAREPOINT_SITE_ALIAS=operations-maintenance

# Copilot Studio values are used when configuring or pulling the local agent project.
COPILOT_STUDIO_ENVIRONMENT_ID=
COPILOT_STUDIO_DATAVERSE_ENDPOINT=
COPILOT_STUDIO_AGENT_ID=
COPILOT_STUDIO_FABRIC_CONNECTION_REFERENCE=
